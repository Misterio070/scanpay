{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Misterio070/scanpay",
  "description": "Deterministic code security scanner for AI agents. 45+ vulnerability patterns, AST analysis, Solana micropayments via x402.",
  "repository": {
    "url": "https://github.com/Misterio070/scanpay",
    "source": "github",
    "subfolder": "npm/scanpay-mcp"
  },
  "version": "1.1.0",
  "remotes": [
    {
      "type": "sse",
      "url": "https://scanpay-ob3w.onrender.com/sse"
    },
    {
      "type": "http",
      "url": "https://scanpay-ob3w.onrender.com/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "scanpay-mcp-server",
      "version": "0.3.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "ScanPay API URL (default: https://scanpay-ob3w.onrender.com)",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "SCANPAY_URL"
        }
      ]
    }
  ]
}
