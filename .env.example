# ScanPay environment configuration
# Copy to .env and fill in values. NEVER commit .env.

# Payment mode: disabled (default), testnet, or mainnet
SCANPAY_PAYMENT_MODE=disabled

# Port for the API server
SCANPAY_PORT=8484

# Merchant Solana wallet address (required for testnet/mainnet)
# SCANPAY_MERCHANT_WALLET=

# Solana RPC endpoint (testnet default)
SCANPAY_RPC_URL=https://api.devnet.solana.com

# Expected price in lamports (0.01 SOL = 10_000_000 lamports)
SCANPAY_PRICE_LAMPORTS=10000000

# CORS allowed origins (comma-separated). Default: localhost only for safety.
SCANPAY_CORS_ORIGINS=http://localhost:8484,http://127.0.0.1:8484

# Free trial configuration
SCANPAY_FREE_TRIAL_ENABLED=false